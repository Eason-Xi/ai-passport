# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# 限定猜拳最重的页面（带 toast 的对手列表）在电脑预览（64 位指针，偏保守）里峰值约 20 KB，
# 取 36 KB 留出 ≥40% 余量。见 tools/render_kj_preview.py。
CONFIG_LV_MEM_SIZE_KILOBYTES=36
# 所有控件都 lv_obj_remove_style_all() 后自带样式，不需要默认主题。
CONFIG_LV_USE_THEME_DEFAULT=n
# 保留缺字占位框：缺字时显示方框而不是空白，便于发现问题。
CONFIG_LV_USE_FONT_PLACEHOLDER=y
CONFIG_LV_TXT_ENC_UTF8=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# 二维码（登记昵称、配网热点）。不要打开 CONFIG_LV_BIN_DECODER_RAM_LOAD：
# 打开后 I1 格式的二维码画布会被整幅转成 ARGB8888（约 100 KB），关闭时按行解码。
CONFIG_LV_USE_QRCODE=y

# --- 无线 ---
# 限定猜拳经现场 Wi-Fi + 电脑 hub 联机（UDP 小包）；配网用 SoftAP 网页，不用蓝牙：关闭蓝牙省 RAM 与 Flash。
CONFIG_BT_ENABLED=n
# 游戏帧很小：关闭 AMPDU、减少静态接收缓冲，给无 PSRAM 的 C3 省内存。
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# 吞吐很低，不需要把 Wi-Fi 收发热路径放进 IRAM：省下约 20 KB 内部 RAM 给堆。
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# --- lwIP ---
# 只用 IPv4（局域网里的电脑 hub）。
CONFIG_LWIP_IPV6=n
# 人多时庄家一瞬间会收到很多选手的包：加大 UDP 收包邮箱，少丢包。
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
# 庄家看板 TCP 只传文本行：收发窗口用 2 个 MSS，省内存。
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880

# --- HTTP 服务（只在配网模式运行）---
# 手机的联网探测请求头很长，至少留 1 KB。
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
